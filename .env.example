# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (override only if you want to pin snapshots; confirm IDs in the docs)
MODEL_TRIAGE=claude-haiku-4-5
MODEL_STANDARD=claude-sonnet-4-6
MODEL_HEAVY=claude-opus-4-8

# --- Heartbeat ---
HEARTBEAT_INTERVAL_MS=900000          # 15 min. Raise to 1800000 (30 min) to cut cost further.

# --- Constraint: inbound-read-only work domains (never receive outbound) ---
READ_ONLY_DOMAINS=flyerdefense.com,disney.com

# --- Twilio ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...    # preferred; or set TWILIO_FROM instead
TWILIO_FROM=+1...
OWNER_PHONE=+1...                     # where approval requests + FYIs are sent

# --- iMessage via BlueBubbles (family channel; runs on Lloyd's Mac mini) ---
# Leave IMESSAGE_SERVER_URL/PASSWORD unset to keep iMessage disabled (Twilio-only).
# When set, outbound iMessage replaces the tappable-link hack for Apple recipients;
# Twilio stays the fallback for non-Apple numbers (school, vendors).
IMESSAGE_SERVER_URL=                  # e.g. http://127.0.0.1:1234 (BlueBubbles REST API)
IMESSAGE_PASSWORD=                    # BlueBubbles server password
IMESSAGE_LISTEN_HOST=127.0.0.1        # bind the webhook listener to localhost only
IMESSAGE_LISTEN_PORT=1235             # BlueBubbles webhook target (point BB here)
IMESSAGE_ALLOW=                       # optional CSV of allowed handles (E.164 / Apple IDs); empty = allow all
OWNER_IMESSAGE=                       # optional; owner's iMessage handle (defaults to OWNER_PHONE)

# --- Azure Storage Queue (front-door handoff) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
INBOUND_QUEUE_NAME=inbound-messages
MAX_DEQUEUE=5                          # poison after this many failed deliveries -> dead-letter
# DEAD_LETTER_QUEUE_NAME defaults to <INBOUND_QUEUE_NAME>-poison; override only if needed.

# --- Microsoft Graph (chief-of-staff mailbox) ---
GRAPH_TENANT_ID=...
GRAPH_CLIENT_ID=...
GRAPH_CLIENT_SECRET=...
# Primary CoS address. Keep assistant@freyfam.com as an ALIAS on this mailbox so
# existing mail still lands. Per-persona inbound routing (later) uses free shared
# mailboxes scoped per specialist via Graph Application Access Policy.
GRAPH_MAILBOX=cos@freyfam.com

# Family calendars Lloyd reads + merges (the real schedule, not cos@). Comma-separated.
GRAPH_CALENDARS=nic@freyfam.com,shelli@freyfam.com
GRAPH_CALENDAR_WRITE=nic@freyfam.com   # where NEW events are created
GRAPH_CALENDAR_DAYS=7                   # days forward the schedule view spans
# Signature appended to emails Lloyd composes/replies (use \n for line breaks):
COS_EMAIL_SIGNATURE=Warm regards,\nLloyd\nChief of Staff to the Frey Family\n(an automated assistant writing on the family's behalf)
CONTACTS_PATH=./data/contacts.json     # addresses Lloyd has emailed (for first-contact intros)
# Clickable email approvals: each staged action emails Approve/Deny buttons here
# (mailto links that pre-fill the YES/NO reply). Comma-separated; empty disables.
APPROVAL_EMAIL_TO=nic@freyfam.com

# --- Browser automation (place_order / browse_page; LOCAL on Lloyd's Mac only) ---
# Orders MUST run from a real residential IP (Lloyd's Mac), never an Azure
# specialist. To use the device's saved Chrome logins/passwords at checkout, point
# at that device's Chrome profile and use the real Chrome channel:
BROWSER_CHANNEL=                       # "chrome" to drive real Chrome (saved creds); empty = bundled Chromium
BROWSER_USER_DATA_DIR=                 # path to the Chrome profile w/ saved logins; empty = ephemeral profile
BROWSER_HEADLESS=true                  # set false for ordering if the profile/site needs a visible window
BROWSER_SLOWMO_MS=0                    # Playwright slowMo on every action
# Order pacing: human-like pause between checkout steps (orders run in the morning
# with hours to spare, so slow + a signed-in profile beats bot detection).
ORDER_STEP_MIN_MS=4000
ORDER_STEP_MAX_MS=9000

# --- Resale feed (Shey's saved searches run on a schedule -> surface new finds) ---
# Daytime cadence (~every 2-2.5h) for the always-posting sites; 07:05 & 16:05 hit
# TheRealReal's 7a/4p drops exactly. Fewer times = cheaper/staler, more = fresher/pricier.
RESALE_RUN_TIMES=07:05,09:30,12:00,14:30,16:05,18:30,20:30
RESALE_RUN_WINDOW_MIN=30                # catch-up window after each slot (>= heartbeat interval)

# --- Local brain ---
BRAIN_PATH=./data/brain.json

# --- Specialist transport (the delegate seam; see CLAUDE.md Topology) ---
# 'local' runs specialists in-process (default). 'remote' calls each specialist's
# endpoint over HTTP. A URL can point at an Azure Function OR a Mac on the LAN
# running deploy/specialists/local-server.mjs - the transport is identical; only
# the host differs. Cutover is per-agent: no URL = stays in-process even in
# remote mode, so you can move them over one at a time.
COS_SPECIALIST_MODE=remote             # local | remote
COS_SPECIALIST_KEY=                    # global fallback function key (per-agent keys below win)
COS_SPECIALIST_TIMEOUT_MS=30000        # cold-start + run budget per delegation
#
# Topology (CONFIRMED): finance/resale/chef -> Azure Functions; dev (Steve) +
# security (Frank) -> local Macs on the LAN; Lloyd is the local host (not listed).
# Azure URLs are printed by deploy/publish-specialists.sh.
COS_SPECIALIST_URL_FINANCE=            # AZURE: https://<app>.azurewebsites.net/api/specialist
COS_SPECIALIST_KEY_FINANCE=
COS_SPECIALIST_URL_RESALE=             # AZURE
COS_SPECIALIST_KEY_RESALE=
COS_SPECIALIST_URL_CHEF=               # AZURE
COS_SPECIALIST_KEY_CHEF=
COS_SPECIALIST_URL_DEV=                # LOCAL MAC (Steve), e.g. http://steve-mbp.local:8787/
COS_SPECIALIST_KEY_DEV=
COS_SPECIALIST_URL_SECURITY=           # LOCAL MAC (Frank), e.g. http://frank-mini.local:8787/
COS_SPECIALIST_KEY_SECURITY=
#
# On each LOCAL Mac specialist (NOT on Lloyd), run `npm run specialist` with:
# COS_AGENT=dev|security  PORT=8787  COS_SPECIALIST_LOCAL_KEY=<same key as above>

# --- Dev backend (workstream Q): Steve on a Claude Code SUBSCRIPTION, not the API ---
# Set these on STEVE's Mac (the dev specialist host), where `claude` is logged in
# via /login (subscription OAuth, NOT an API key). Default 'api' = no change.
# CRITICAL: do NOT also set ANTHROPIC_API_KEY in Steve's process env -- it shadows
# the subscription. The backend scrubs it from the child, but keep Steve's env clean.
COS_DEV_BACKEND=api                    # api | claude-code
CLAUDE_CODE_BIN=claude                 # headless Claude Code binary (path or name)
COS_DEV_CWD=                           # workspace dir Steve operates in (default: cwd)
COS_DEV_TIMEOUT_MS=180000              # per-task budget (a dev task may build/test)
COS_DEV_FALLBACK_API=true              # on usage cap / failure, spill back to the metered API

# --- Logging ---
LOG_LEVEL=info                         # error | warn | info | debug (structured JSON lines)

# --- Cost watchdog (texts OWNER_PHONE when a billing cycle crosses the limit) ---
COST_ALERT_USD=100                    # first alert when month-to-date spend crosses this
COST_ALERT_STEP_USD=50                # re-alert every +$50 if it keeps climbing
COST_CYCLE_DAY=1                      # day-of-month the billing cycle resets (UTC); 1 for standard plans
COST_CHECK_INTERVAL_MS=3600000        # how often to poll the billing APIs (1h). Reads are free / no model tokens.
COST_STATE_PATH=./data/cost-alerts.json
# Anthropic Console spend: ADMIN key (sk-ant-admin...), NOT the inference key above.
# Console -> Settings -> Admin keys (org owner only). Leave blank to skip this meter.
# Backstop (independent of this daemon): also set a monthly spend limit in the
# Console (Settings -> Limits) -- it emails the org owner and can hard-cap usage,
# which this daemon cannot do. The Azure equivalent is deploy/azure-budget.sh.
ANTHROPIC_ADMIN_KEY=sk-ant-admin...
# Azure spend: a service principal with the "Cost Management Reader" role on the
# subscription. Leave blank to skip this meter.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=...
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
# Brave Search overage: no billing API, so we meter queries this daemon makes and
# bill anything above the plan quota. Set the rate to your plan's overage CPM to
# enable; leave at 0 to skip. Match these to your Brave plan.
BRAVE_INCLUDED_QUERIES=0              # queries included per month before overage (your plan's quota)
BRAVE_OVERAGE_USD_PER_1K=0            # overage price per 1,000 queries (USD); >0 turns this meter on

# --- Slack desk channel (Socket Mode; workstream K) ---
# Both required to enable Slack; daemon runs fine without them. Create a Slack app,
# enable Socket Mode, add an app-level token (xapp-, scope connections:write) and a
# bot token (xoxb-). Then: npm i @slack/bolt
#
# BOT TOKEN SCOPES (Slack app -> OAuth & Permissions -> Bot Token Scopes):
#   chat:write        send replies + approval buttons
#   channels:history, groups:history, im:history, mpim:history   read messages
#   channels:read, groups:read   resolve a channel id -> name (per-agent routing)
#   files:read        DOWNLOAD shared images/PDFs. WITHOUT THIS, Slack serves
#                     url_private as an HTML sign-in page (200, not the file), so a
#                     photo is silently dropped and the specialist sees text only --
#                     e.g. Shey "can't see" an item photo posted in #resale.
# Changing scopes requires REINSTALLING the app (Install App -> Reinstall).
#
# CHANNEL MEMBERSHIP: the bot must be a MEMBER of every channel it should read,
# per channel -- `/invite @yourbot` in #cos, #resale, #finance, #dev, #chef,
# #security, #command. files:read only works from channels the bot is in, so a bot
# invited to #cos but not #resale downloads Lloyd's images but not Shey's.
SLACK_APP_TOKEN=                       # xapp-...
SLACK_BOT_TOKEN=                       # xoxb-...
SLACK_COMMAND_CHANNEL=#command         # where delegations + approval buttons are mirrored

# --- Calendar (scheduling) ---
FAMILY_TZ=America/Los_Angeles          # timezone for calendar event times
# NOTE: calendar tools need Graph **Calendars.ReadWrite** app permission + admin
# consent on the app registration (Mail.Read/Send are already granted).

# --- Morning digest ---
DIGEST_ENABLED=true                    # daily morning digest (Lloyd delegates to specialists)
DIGEST_HOUR=7                          # local hour to send (FAMILY_TZ)
DIGEST_WINDOW_HOURS=2                  # only send within this window after DIGEST_HOUR

# digest email recipients (comma-separated); reliable channel while SMS clears
DIGEST_EMAIL_TO=nic@freyfam.com,shelli@freyfam.com

# --- Finance: spend ingestion + weekly report (Patrick) ---
# Daily batch that drains queued bank/card transaction alerts into the spend log
# (one cheap Haiku call + reconcile pass). Off by default; turn on once the Gmail
# forwarding of card AND Chase-checking alerts to cos@ is set up.
FINANCE_INGEST_ENABLED=false
FINANCE_INGEST_HOUR=6                   # local hour for the daily ingest batch
# Weekly Sunday-night report: checking vs credit, MoM + YoY; first Sunday of the
# month adds a prior-month retrospective and closes that month into the baselines.
FINANCE_REPORT_ENABLED=false
FINANCE_REPORT_WEEKDAY=0                # 0 = Sunday
FINANCE_REPORT_HOUR=20                  # local hour (evening)
FINANCE_REPORT_WINDOW_HOURS=3
# Owner-only delivery (finance is sensitive). Comma-separated; empty disables email.
FINANCE_REPORT_EMAIL_TO=nic@freyfam.com

# --- Package / shipment tracking (ingestion prerequisite) ---
# The tracking BRAIN (parse tracking numbers, ship-vs-delivered, owner + pickup
# detection, calendar pickup proposal, morning "Arriving:" line, afternoon pickup
# digest) is fully wired. It only sees carrier mail that reaches THIS mailbox
# (GRAPH_MAILBOX = cos@freyfam.com); the COS never reads Gmail directly. Carrier
# and UPS notices land in the family Gmail accounts, so the legacy Gmail hookup
# must reach this mailbox. NOTE: assistant@freyfam.com is an ALIAS of this mailbox
# (see GRAPH_MAILBOX above), so legacy Gmail forwards that already target
# assistant@ land in the SAME inbox the scan reads -- no repoint needed, just
# confirm the alias still exists on cos@ and that the forward keeps the carrier as
# the From (a forward that rewrites From to assistant@ is skipped as "self"). If a
# family account has NO such forward, add a Gmail filter (nfrey2@, shelliafrey@,
# foxsfrey@, nicholasbfrey@) auto-forwarding shipping/delivery mail (UPS/USPS/
# FedEx/Amazon + "shipped"/"delivered"/"out for delivery") to cos@ (or assistant@).
# Without a forward reaching this mailbox, nothing is tracked and nothing surfaces
# in the digest or on the calendar. Same forwarding dependency as finance above.

# --- Afternoon package-pickup digest (weekday 5:30pm, iMessage to owner) ---
# Lists packages delivered TODAY to the UPS Store (Foothill) so they can be
# grabbed on the way home. Deterministic (no model). Sent via iMessage ONLY
# (needs IMESSAGE_* configured + OWNER_IMESSAGE/OWNER_PHONE). On by default.
PACKAGE_DIGEST_ENABLED=true
PACKAGE_DIGEST_HOUR=17
PACKAGE_DIGEST_MINUTE=30
PACKAGE_DIGEST_WINDOW_MINUTES=60       # catch-up window after the target time
PACKAGE_DIGEST_WEEKDAYS_ONLY=true      # Mon-Fri only

# --- Azure Maps (precise commute times w/ live traffic; commute_time tool) ---
AZURE_MAPS_KEY=                        # Azure Maps account subscription key

# --- Web search (workstream N; `search` tool for chief + resale + security) ---
SEARCH_PROVIDER=brave                  # currently only "brave"
BRAVE_SEARCH_KEY=                      # api.search.brave.com key; empty => search degrades to "unavailable"
SEARCH_RESULT_COUNT=5                  # max results returned per query

# --- Local embeddings (workstream E; semantic memory recall on the Mac) ---
EMBEDDINGS_PROVIDER=local              # "local" (transformers.js, on-device) or "none" (lexical only)
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_CACHE_DIR=./data/models     # one-time ~90MB model download cached here
